{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blufin-plus-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blufin-plus-api",
      "database_id": "33abc25d-59ab-4569-b789-6726aa6b0dbe"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
