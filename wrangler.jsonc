{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blufin-plus-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  "keep_vars": true,
  "routes": [
    { "pattern": "bluefinplus.site", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build:site"
  },
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blufin-plus-api",
      "database_id": "33abc25d-59ab-4569-b789-6726aa6b0dbe"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
